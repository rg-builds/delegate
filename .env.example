# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=          # the number Delegate calls FROM, E.164
TWILIO_WHATSAPP_NUMBER=+14155238886   # Twilio WhatsApp sandbox number

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_TEXT_MODEL=gpt-5-mini
OPENAI_VOICE=marin

# --- Public URL ---
# ngrok in dev, real host in prod. No trailing slash.
BASE_URL=https://your-tunnel.ngrok-free.dev

# --- Behaviour ---
MAX_CALL_SECONDS=300

# --- Security ---
# Comma-separated E.164 numbers allowed to trigger calls. Empty = allow all.
ALLOWED_WHATSAPP_NUMBERS=+918837557003
# Set to 1 only for local testing without Twilio signatures.
SKIP_SIGNATURE_VALIDATION=0
